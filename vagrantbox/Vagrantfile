# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
config.vm.box = "ubuntu/jammy64"

# Configure our networking and open the required ports
config.vm.network "public_network",
    use_dhcp_assigned_default_route: true
config.vm.network "forwarded_port", guest: 80, host: 8080 # nginx access
config.vm.network "forwarded_port", guest: 5000, host:5000 # flask access
config.vm.boot_timeout = 600

#Configure our shared folder between the host computer and the VM
config.vm.synced_folder "./shared", "/shared"

#Update the installed software and install extra required packages
config.vm.provision "shell",privileged: false, inline: <<-SHELL
    sudo apt update
    sudo apt upgrade -y
    sudo apt install -y nginx lynx vim git sqlite3
    sudo apt install -y python3-pip
    sudo python3 -m pip install Flask
 SHELL
end

